# SRN — environment reference (Design.md §11)
# Copy to .env.local and fill in. NEVER commit the filled-in file.

# --- Supabase --------------------------------------------------------------
# Project ref: vfbqyyrqzmohcfjuknwe
NEXT_PUBLIC_SUPABASE_URL=https://vfbqyyrqzmohcfjuknwe.supabase.co

# Public anon key. Safe in the browser: RLS denies it everything on submission
# tables and limits content reads to published rows (§9 Sprint 3.1).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, never exposed to the client, never imported
# into a client component. Public form writes use this via server actions (§1
# architecture rule).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres password (migrations / direct connections only, not app runtime).
DB_PASSWORD=

# --- Email (Resend, §1) ----------------------------------------------------
# Transactional confirmations for registrations and applications (Phase 4).
RESEND_API_KEY=

# --- Site ------------------------------------------------------------------
# Absolute base URL, used for OG images, sitemap, and email links.
#
# MUST be set to the real domain in production (Vercel > Settings >
# Environment Variables). Leaving localhost here is not a cosmetic slip: it is
# printed onto every certificate PDF as the verification URL, and a certificate
# whose "check this is genuine" link points at localhost is worthless to the
# employer it was written for. The same value is used in enrolment and marking
# emails, whose links would be equally dead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics (added at launch, Sprint 6.3) -------------------------------
PLAUSIBLE_DOMAIN=

# --- Rate limiting (Sprint 3.2 — pick one, then document the choice) -------
# Upstash Redis or Vercel KV, 5 submissions/hour/form.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
